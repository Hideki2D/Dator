<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORS -->

    <Color x:Key="WindowBackgroundColor">#202020</Color>

    <Color x:Key="ControlBackgroundColor">#2B2B2B</Color>

    <Color x:Key="ControlBackgroundHoverColor">#333333</Color>

    <Color x:Key="ControlBackgroundPressedColor">#404040</Color>

    <Color x:Key="ControlBackgroundDisabledColor">#252525</Color>

    <Color x:Key="ControlBorderColor">#484848</Color>

    <Color x:Key="ControlBorderHoverColor">#5C5C5C</Color>

    <Color x:Key="ControlForegroundColor">#FFFFFF</Color>

    <Color x:Key="ControlForegroundDisabledColor">#7D7D7D</Color>

    <Color x:Key="AccentColor">#3B82F6</Color>

    <!-- BRUSHES -->

    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="{DynamicResource WindowBackgroundColor}" />

    <SolidColorBrush
        x:Key="ControlBackgroundBrush"
        Color="{DynamicResource ControlBackgroundColor}" />

    <SolidColorBrush
        x:Key="ControlBackgroundHoverBrush"
        Color="{DynamicResource ControlBackgroundHoverColor}" />

    <SolidColorBrush
        x:Key="ControlBackgroundPressedBrush"
        Color="{DynamicResource ControlBackgroundPressedColor}" />

    <SolidColorBrush
        x:Key="ControlBackgroundDisabledBrush"
        Color="{DynamicResource ControlBackgroundDisabledColor}" />

    <SolidColorBrush
        x:Key="ControlBorderBrush"
        Color="{DynamicResource ControlBorderColor}" />

    <SolidColorBrush
        x:Key="ControlBorderHoverBrush"
        Color="{DynamicResource ControlBorderHoverColor}" />

    <SolidColorBrush
        x:Key="ControlForegroundBrush"
        Color="{DynamicResource ControlForegroundColor}" />

    <SolidColorBrush
        x:Key="ControlForegroundDisabledBrush"
        Color="{DynamicResource ControlForegroundDisabledColor}" />

    <SolidColorBrush
        x:Key="AccentBrush"
        Color="{DynamicResource AccentColor}" />

</ResourceDictionary>