<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FAFAFA</Color>

    <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>

    <Color x:Key="ControlBackgroundHoverColor">#F2F2F2</Color>

    <Color x:Key="ControlBackgroundPressedColor">#E8E8E8</Color>

    <Color x:Key="ControlBackgroundDisabledColor">#F6F6F6</Color>

    <Color x:Key="ControlBorderColor">#D8D8D8</Color>

    <Color x:Key="ControlBorderHoverColor">#C0C0C0</Color>

    <Color x:Key="ControlForegroundColor">#1A1A1A</Color>

    <Color x:Key="ControlForegroundDisabledColor">#909090</Color>

    <Color x:Key="AccentColor">#0067C0</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="{DynamicResource WindowBackgroundColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush"
                     Color="{DynamicResource ControlBackgroundColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundHoverBrush"
                     Color="{DynamicResource ControlBackgroundHoverColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundPressedBrush"
                     Color="{DynamicResource ControlBackgroundPressedColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundDisabledBrush"
                     Color="{DynamicResource ControlBackgroundDisabledColor}"/>

    <SolidColorBrush x:Key="ControlBorderBrush"
                     Color="{DynamicResource ControlBorderColor}"/>

    <SolidColorBrush x:Key="ControlBorderHoverBrush"
                     Color="{DynamicResource ControlBorderHoverColor}"/>

    <SolidColorBrush x:Key="ControlForegroundBrush"
                     Color="{DynamicResource ControlForegroundColor}"/>

    <SolidColorBrush x:Key="ControlForegroundDisabledBrush"
                     Color="{DynamicResource ControlForegroundDisabledColor}"/>

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{DynamicResource AccentColor}"/>

</ResourceDictionary>