<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Explorer.UI.Controls.ExplorerNavigation"
    xmlns:controls="clr-namespace:Explorer.UI.Controls">

    <HierarchicalDataTemplate DataType="{x:Type controls:NavigationItem}" ItemsSource="{Binding Items}">
        <StackPanel Orientation="Horizontal" Margin="2">
            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <Style TargetType="{x:Type ui:ExplorerNavigation}">

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ui:ExplorerNavigation}">

                    <Border
                        Background="{DynamicResource ControlBackgroundBrush}">

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto">

                            <TreeView
                                x:Name="PART_TreeView"
                                BorderThickness="0"
                                Background="Transparent"
                                ItemsSource="{TemplateBinding ItemsSource}">

                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>

                            </TreeView>

                        </ScrollViewer>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>