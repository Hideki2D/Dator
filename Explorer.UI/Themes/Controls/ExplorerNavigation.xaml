<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Explorer.UI.Controls.ExplorerNavigation">

    <Style TargetType="{x:Type ui:ExplorerNavigation}">

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ui:ExplorerNavigation}">

                    <Border
                        Background="{DynamicResource ControlBackgroundBrush}">

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto">

                            <TreeView
                                BorderThickness="0"
                                Background="Transparent"
                                ItemsSource="{TemplateBinding ItemsSource}" />

                        </ScrollViewer>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>