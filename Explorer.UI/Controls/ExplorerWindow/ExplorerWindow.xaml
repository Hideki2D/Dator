<UserControl x:Class="Explorer.UI.Controls.ExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Explorer.UI.Controls.ExplorerNavigation"
             xmlns:layout="clr-namespace:Explorer.UI.Controls.Layout">

    <layout:ShellLayout>

        <layout:ShellLayout.ToolbarContent>
            <Grid Height="40">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Explorer"/>
            </Grid>
        </layout:ShellLayout.ToolbarContent>

        <layout:ShellLayout.AddressBarContent>
            <Border
                Height="36"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentPath}"/>
            </Border>
        </layout:ShellLayout.AddressBarContent>

        <layout:ShellLayout.NavigationContent>
            <ui:ExplorerNavigation
                ItemsSource="{Binding NavigationRoots}"
                SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"/>
        </layout:ShellLayout.NavigationContent>

        <layout:ShellLayout.MainContent>
            <ListBox
        x:Name="FileList"
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding Items}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="FileListItem_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </layout:ShellLayout.MainContent>

        <layout:ShellLayout.StatusBarContent>
            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} элементов}"/>
        </layout:ShellLayout.StatusBarContent>

    </layout:ShellLayout>

</UserControl>