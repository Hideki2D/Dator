<UserControl x:Class="Explorer.UI.Controls.ExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Explorer.UI.Controls.ExplorerNavigation"
             xmlns:layout="clr-namespace:Explorer.UI.Controls.Layout">

    <layout:ShellLayout>

        <layout:ShellLayout.ToolbarContent>
            <Grid Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Width="32" Height="32" Margin="4,0" Padding="0" ToolTip="Назад" Command="{Binding BackCommand}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M13,4 L7,10 L13,16"
                  Stroke="{DynamicResource ControlForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  StrokeLineJoin="Round"
                  Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Width="32" Height="32" Margin="4,0" Padding="0" ToolTip="Вперёд" Command="{Binding ForwardCommand}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M7,4 L13,10 L7,16"
                  Stroke="{DynamicResource ControlForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  StrokeLineJoin="Round"
                  Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Width="32" Height="32" Margin="4,0" Padding="0" ToolTip="Уровень выше" Command="{Binding UpCommand}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M4,13 L10,7 L16,13"
                  Stroke="{DynamicResource ControlForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  StrokeLineJoin="Round"
                  Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Width="32" Height="32" Margin="4,0" Padding="0" ToolTip="Обновить" Command="{Binding RefreshCommand}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M17.65,6.35 A7.958,7.958 0 0 0 12,4 C7.58,4 4.01,7.58 4.01,12 S7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 S8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z"
                  Fill="{DynamicResource ControlForegroundBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </layout:ShellLayout.ToolbarContent>
        <layout:ShellLayout.AddressBarContent>
            <Border
                Height="36"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentPath}"/>
            </Border>
        </layout:ShellLayout.AddressBarContent>

        <layout:ShellLayout.NavigationContent>
            <ui:ExplorerNavigation
                ItemsSource="{Binding NavigationRoots}"
                SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"/>
        </layout:ShellLayout.NavigationContent>

        <layout:ShellLayout.MainContent>
            <ListBox
        x:Name="FileList"
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding Items}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="FileListItem_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </layout:ShellLayout.MainContent>

        <layout:ShellLayout.StatusBarContent>
            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} элементов}"/>
        </layout:ShellLayout.StatusBarContent>

    </layout:ShellLayout>

</UserControl>