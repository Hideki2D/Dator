<UserControl x:Class="Explorer.UI.Controls.ExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Explorer.UI.Controls.ExplorerNavigation"
             xmlns:layout="clr-namespace:Explorer.UI.Controls.Layout">

    <layout:ShellLayout>

        <!-- ===================================================== -->
        <!-- Toolbar -->
        <!-- ===================================================== -->

        <layout:ShellLayout.ToolbarContent>

            <Grid Height="40">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Explorer"/>

            </Grid>

        </layout:ShellLayout.ToolbarContent>

        <!-- ===================================================== -->
        <!-- Address -->
        <!-- ===================================================== -->

        <layout:ShellLayout.AddressBarContent>

            <Border
                Height="36"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="C:\"/>

            </Border>

        </layout:ShellLayout.AddressBarContent>

        <!-- ===================================================== -->
        <!-- Navigation -->
        <!-- ===================================================== -->

        <layout:ShellLayout.NavigationContent>

            <ui:ExplorerNavigation/>

        </layout:ShellLayout.NavigationContent>

        <!-- ===================================================== -->
        <!-- Main -->
        <!-- ===================================================== -->

        <layout:ShellLayout.MainContent>

            <Grid>

                <TextBlock
                    FontSize="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Explorer Content"/>

            </Grid>

        </layout:ShellLayout.MainContent>

        <!-- ===================================================== -->
        <!-- Status -->
        <!-- ===================================================== -->

        <layout:ShellLayout.StatusBarContent>

            <TextBlock Text="0 items"/>

        </layout:ShellLayout.StatusBarContent>

    </layout:ShellLayout>

</UserControl>